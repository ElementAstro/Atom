/**
 * @file version.h
 * @brief Auto-generated Atom version header file
 *
 * This file is automatically generated by CMake. Do not modify manually.
 * For script-based generation, use scripts/version/version-manager.sh or version.ps1
 *
 * @note Compatible with both CMake and script-based version generation
 */

#ifndef ATOM_VERSION_H
#define ATOM_VERSION_H

// =============================================================================
// Version Numbers
// =============================================================================

/** @brief Atom version string (e.g. "1.2.3") */
#define ATOM_VERSION "@PROJECT_VERSION@"

/** @brief Atom major version number */
#define ATOM_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/** @brief Atom minor version number */
#define ATOM_VERSION_MINOR @PROJECT_VERSION_MINOR@

/** @brief Atom patch version number */
#define ATOM_VERSION_PATCH @PROJECT_VERSION_PATCH@

/** @brief Version as a single integer: (major << 16) | (minor << 8) | patch */
#define ATOM_VERSION_NUMBER ((ATOM_VERSION_MAJOR << 16) | (ATOM_VERSION_MINOR << 8) | ATOM_VERSION_PATCH)

// =============================================================================
// Git Information
// =============================================================================

/** @brief Git commit short hash */
#define ATOM_GIT_HASH "@GIT_HASH@"

/** @brief Git branch name */
#define ATOM_GIT_BRANCH "@GIT_BRANCH@"

/** @brief Git tag (if any) */
#define ATOM_GIT_TAG "@GIT_TAG@"

/** @brief Whether the working directory has uncommitted changes (1=dirty, 0=clean) */
#define ATOM_GIT_DIRTY @GIT_DIRTY_RESULT@

/** @brief Number of commits since last tag */
#define ATOM_GIT_COMMIT_COUNT @GIT_COMMIT_COUNT@

// =============================================================================
// Build Information
// =============================================================================

/** @brief Build timestamp (ISO 8601 format) */
#define ATOM_BUILD_TIME "@BUILD_TIME@"

/** @brief Build type (Debug, Release, RelWithDebInfo, MinSizeRel) */
#define ATOM_BUILD_TYPE "@CMAKE_BUILD_TYPE@"

/** @brief Compiler identification string */
#define ATOM_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@"

/** @brief Compiler version */
#define ATOM_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@"

/** @brief Target system name */
#define ATOM_SYSTEM_NAME "@CMAKE_SYSTEM_NAME@"

/** @brief Target processor architecture */
#define ATOM_SYSTEM_PROCESSOR "@CMAKE_SYSTEM_PROCESSOR@"

// =============================================================================
// C API Functions
// =============================================================================

#ifdef __cplusplus
extern "C" {
#endif

/**
 * @brief Get the full Atom version string
 * @return Version string (e.g. "1.2.3")
 */
static inline const char* atom_get_version(void) {
    return ATOM_VERSION;
}

/**
 * @brief Get the version number as a single integer
 * @return Version number: (major << 16) | (minor << 8) | patch
 */
static inline unsigned int atom_get_version_number(void) {
    return ATOM_VERSION_NUMBER;
}

/**
 * @brief Get the Git commit hash
 * @return Git commit short hash string
 */
static inline const char* atom_get_git_hash(void) {
    return ATOM_GIT_HASH;
}

/**
 * @brief Check if the build has uncommitted changes
 * @return 1 if dirty, 0 if clean
 */
static inline int atom_is_dirty_build(void) {
    return ATOM_GIT_DIRTY;
}

/**
 * @brief Check if the current Atom version meets the minimum version requirement
 * @param major Required minimum major version
 * @param minor Required minimum minor version
 * @param patch Required minimum patch version
 * @return 1 if current version >= specified version, 0 otherwise
 */
static inline int atom_check_version(int major, int minor, int patch) {
    unsigned int required = ((unsigned int)major << 16) | ((unsigned int)minor << 8) | (unsigned int)patch;
    return ATOM_VERSION_NUMBER >= required;
}

#ifdef __cplusplus
}
#endif

// =============================================================================
// C++ API (namespace atom::version)
// =============================================================================

#ifdef __cplusplus

#include <string_view>
#include <cstdint>

namespace atom::version {

// Version numbers
inline constexpr int MAJOR = ATOM_VERSION_MAJOR;
inline constexpr int MINOR = ATOM_VERSION_MINOR;
inline constexpr int PATCH = ATOM_VERSION_PATCH;
inline constexpr std::string_view VERSION_STRING = ATOM_VERSION;

// Git information
inline constexpr std::string_view GIT_HASH = ATOM_GIT_HASH;
inline constexpr std::string_view GIT_BRANCH = ATOM_GIT_BRANCH;
inline constexpr std::string_view GIT_TAG = ATOM_GIT_TAG;
inline constexpr bool GIT_DIRTY = ATOM_GIT_DIRTY != 0;
inline constexpr int GIT_COMMIT_COUNT = ATOM_GIT_COMMIT_COUNT;

// Build information
inline constexpr std::string_view BUILD_TIME = ATOM_BUILD_TIME;
inline constexpr std::string_view BUILD_TYPE = ATOM_BUILD_TYPE;
inline constexpr std::string_view COMPILER_ID = ATOM_COMPILER_ID;
inline constexpr std::string_view COMPILER_VERSION = ATOM_COMPILER_VERSION;
inline constexpr std::string_view SYSTEM_NAME = ATOM_SYSTEM_NAME;
inline constexpr std::string_view SYSTEM_PROCESSOR = ATOM_SYSTEM_PROCESSOR;

/**
 * @brief Get version as a single number for easy comparison
 * @return (major << 16) | (minor << 8) | patch
 */
inline constexpr std::uint32_t version_number() noexcept {
    return (static_cast<std::uint32_t>(MAJOR) << 16) |
           (static_cast<std::uint32_t>(MINOR) << 8) |
           static_cast<std::uint32_t>(PATCH);
}

/**
 * @brief Check if build is from dirty working directory
 * @return true if there were uncommitted changes
 */
inline constexpr bool is_dirty() noexcept {
    return GIT_DIRTY;
}

/**
 * @brief Check if version meets minimum requirement
 * @param major Required minimum major version
 * @param minor Required minimum minor version
 * @param patch Required minimum patch version
 * @return true if current version >= required version
 */
inline constexpr bool check_version(int major, int minor, int patch) noexcept {
    return version_number() >= ((static_cast<std::uint32_t>(major) << 16) |
                                (static_cast<std::uint32_t>(minor) << 8) |
                                static_cast<std::uint32_t>(patch));
}

} // namespace atom::version

#endif // __cplusplus

#endif // ATOM_VERSION_H
