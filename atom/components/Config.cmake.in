# Config.cmake.in for atom-component
# This file is used by CMake to generate the package configuration file

@PACKAGE_INIT@

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

# Set the component found variable
set(@PROJECT_NAME@_FOUND TRUE)

# Provide information about the package
set(@PROJECT_NAME@_VERSION "@PROJECT_VERSION@")
set(@PROJECT_NAME@_VERSION_MAJOR "@PROJECT_VERSION_MAJOR@")
set(@PROJECT_NAME@_VERSION_MINOR "@PROJECT_VERSION_MINOR@")
set(@PROJECT_NAME@_VERSION_PATCH "@PROJECT_VERSION_PATCH@")

# Feature availability
set(@PROJECT_NAME@_LUA_SUPPORT @ATOM_ENABLE_LUA@)
set(@PROJECT_NAME@_PYTHON_SUPPORT @ATOM_ENABLE_PYTHON@)

# Include directories for new structure
set(@PROJECT_NAME@_INCLUDE_DIRS "${CMAKE_CURRENT_LIST_DIR}/../../../include/atom/components")

# Component categories available
set(@PROJECT_NAME@_CORE_AVAILABLE TRUE)
set(@PROJECT_NAME@_SCRIPTING_AVAILABLE TRUE)
set(@PROJECT_NAME@_LIFECYCLE_AVAILABLE TRUE)
set(@PROJECT_NAME@_DATA_AVAILABLE TRUE)

# Check for required components
check_required_components(@PROJECT_NAME@)
